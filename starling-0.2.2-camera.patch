     #[test]
+    fn attack_and_use_can_turn_the_view_while_remaining_held() {
+        let (l, now) = (layout(), Instant::now());
+        let mut t = TouchControls::default();
+        let attack = [2608.0, 879.0];
+        assert_eq!(
+            t.event(&l, 7, TouchPhase::Started, attack, now),
+            vec![Action::Press(Button::Attack)]
+        );
+        assert!(t.held(Button::Attack));
+        let turn = t.event(&l, 7, TouchPhase::Moved, [2640.0, 879.0], now);
+        assert!(matches!(turn[..], [Action::Look(dx, dy)] if dx > 0.0 && dy == 0.0));
+        assert!(t.held(Button::Attack));
+        assert_eq!(
+            t.event(&l, 7, TouchPhase::Ended, [2640.0, 879.0], now),
+            vec![Action::Release(Button::Attack)]
+        );
+        assert!(!t.held(Button::Attack));
+    }
